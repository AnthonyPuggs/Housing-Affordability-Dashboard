# RBA download caches: pipeline artefacts, not outputs. Committing them froze
# CI refreshes (checkout resets mtimes, so the 24h cache check always passed
# and the download branch never ran). rba_rates.csv is the tracked output.
data/rba_*_raw.csv
data/rba_*_raw.xlsx

# Local OS and editor artefacts
.DS_Store
.Rhistory
.RData
.Rproj.user/
.Ruserdata

# Local assistant/session metadata
.claude/
AGENTS.md
quality_reports/
.app_old.R

# Temporary Office lock files
resources/ABS_data/**/~$*

# renv local libraries and caches; keep renv.lock tracked when introduced
renv/library/
renv/staging/
renv/python/
renv/local/
renv/cellar/

# Graphify temporary files; keep the report and graph JSON
.graphify_*

graphify-out/*
!graphify-out/
!graphify-out/GRAPH_REPORT.md
!graphify-out/graph.json
